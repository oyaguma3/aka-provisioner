# aka-provisioner の設定。このファイルを .env にコピーして書き換え、パーミッションを 600 にする。
# 下流の登録簿（downstreams/downstreams.json）と管理クライアントのピン（secrets/admin-clients）はファイルで置き、
# 直したら docker compose kill -s HUP aka-provisioner で読み直す（運用ガイド 3 章・4 章）。

# ---- 構成 ----

# 下流と同じホストで試す場合は、共有ネットワークに参加する設定を重ねる。
#   aka-radius が同一ホスト: compose.aka-radius-admin.yaml を加える
#   aka-vecgen が同一ホスト: compose.aka-av.yaml を加える
# 本番では下流は別のノードにあり、サービス用の WireGuard のアドレスで接続する（重ねない）。
COMPOSE_FILE=compose.yaml
# 同一ホストの aka-radius が作る共有ネットワークの名前（aka-radius 側の RADIUS_ADMIN_SHARED_NETWORK と同じにする）。
RADIUS_ADMIN_SHARED_NETWORK=aka-radius-admin
# 同一ホストの aka-vecgen が作る共有ネットワークの名前（aka-vecgen 側の VECGEN_SHARED_NETWORK と同じにする）。
VECGEN_SHARED_NETWORK=aka-av
# provisioner が作る、同一ホストの管理クライアント（aka-ossbss）向けの共有ネットワークの名前。
PROVISIONER_SHARED_NETWORK=aka-provisioner

# ---- 必須 ----

# provisioner 専用の Valkey のパスワード（下流の Valkey のパスワードとは別のもの）。
PROVISIONER_VALKEY_PASSWORD=change-me

# ---- provisioner の API ----

# 公開するホスト側のアドレスとポート。サービス用の WireGuard のアドレスかループバックに限定する。
PROVISIONER_PUBLISH=127.0.0.1:9446

# 自己署名のサーバー証明書を初回起動時に自動生成するとき、SAN に入れるホスト名と IP アドレス。
# 管理クライアントが接続に使う名前や IP アドレスをカンマ区切りで指定する（同一ホストの aka-ossbss は aka-provisioner）。
# 生成済みの証明書には反映されない。
PROVISIONER_TLS_HOSTS=localhost,127.0.0.1,aka-provisioner

# 持ち込みの証明書を使う場合は、certs/ に置いてコンテナ内のパス（/certs/...）を指定する。
# 空なら自己署名（/data/tls/ に自動生成）を使う。SIGHUP で読み直す。
PROVISIONER_TLS_CERT=
PROVISIONER_TLS_KEY=

# ---- その他 ----

# 下流の 1 回の呼び出しの上限時間（30s まで）。
PROVISIONER_DOWNSTREAM_TIMEOUT=5s
PROVISIONER_LOG_LEVEL=info
# 監査ログの Stream の件数の上限（おおよそ）と、日ごとのファイル（audit/）を持つ日数。
PROVISIONER_AUDIT_MAX=100000
PROVISIONER_AUDIT_RETENTION_DAYS=14
# 管理面の Fluent Bit がホストで待ち受けるポート（同じホストで aka-radius と並べて試すときだけ変える）。
PROVISIONER_FLUENT_BIT_PORT=24224
# イメージのタグと、ログの version に出すビルドの版。
PROVISIONER_VERSION=dev
